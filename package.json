{
  "name": "@ethan741205/dsh-strata-sync",
  "version": "0.8.0",
  "description": "Native DSH settings UI for synchronizing Strata Server models, context and compaction budgets",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@npmcli/package-json": "7.0.5",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethan741205/dsh-strata-sync.git"
  },
  "homepage": "https://github.com/ethan741205/dsh-strata-sync#readme",
  "bugs": {
    "url": "https://github.com/ethan741205/dsh-strata-sync/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "strata",
    "llm",
    "plugin",
    "model-sync"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
